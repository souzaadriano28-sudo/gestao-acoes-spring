# Document-only template. Spring Boot does not load this file automatically.
# Every secret below is deliberately nonfunctional.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/gestao_acoes
DB_USERNAME=postgres
DB_PASSWORD=not-a-real-database-password
BRAPI_TOKEN=not-a-real-brapi-token
TWELVEDATA_API_KEY=not-a-real-twelvedata-key
ADMIN_INITIAL_USERNAME=replace-with-an-admin-identifier
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-secret-from-a-vault
AUTH_MAX_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW=PT15M
AUTH_LOCK_DURATION=PT15M
SESSION_IDLE_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
INTEGRATIONS_BRAPI_URL=https://brapi.dev/api
INTEGRATIONS_TWELVEDATA_URL=https://api.twelvedata.com
INTEGRATIONS_BRASILAPI_URL=https://brasilapi.com.br/api/cnpj/v1
INTEGRATIONS_VIACEP_URL=https://viacep.com.br/ws
APP_CORS_ALLOWED_ORIGIN=http://localhost:4200
