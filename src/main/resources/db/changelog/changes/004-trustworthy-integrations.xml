<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="007-create-exchange-rate-snapshot" author="atlas-carteira">
        <createTable tableName="exchange_rate_snapshot">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" primaryKeyName="pk_exchange_rate_snapshot" nullable="false"/></column>
            <column name="base_currency" type="VARCHAR(3)"><constraints nullable="false"/></column>
            <column name="quote_currency" type="VARCHAR(3)"><constraints nullable="false"/></column>
            <column name="rate" type="DECIMAL(19,8)"><constraints nullable="false"/></column>
            <column name="source_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="provider" type="VARCHAR(80)"><constraints nullable="false"/></column>
            <column name="reference_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="fetched_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="reference_kind" type="VARCHAR(60)"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="exchange_rate_snapshot" columnNames="base_currency,quote_currency"
                constraintName="uk_exchange_rate_pair"/>
        <sql>ALTER TABLE exchange_rate_snapshot ADD CONSTRAINT ck_exchange_rate_positive CHECK (rate &gt; 0 AND base_currency &lt;&gt; quote_currency)</sql>
        <rollback><dropTable tableName="exchange_rate_snapshot"/></rollback>
    </changeSet>

    <changeSet id="008-add-regulatory-evidence" author="atlas-carteira">
        <addColumn tableName="corretora">
            <column name="regulatory_status" type="VARCHAR(20)" defaultValue="NOT_CHECKED"><constraints nullable="false"/></column>
            <column name="regulatory_category" type="VARCHAR(120)"/>
            <column name="regulatory_source" type="VARCHAR(160)"/>
            <column name="regulatory_evidence_id" type="VARCHAR(80)"/>
            <column name="regulatory_reference_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="regulatory_checked_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="regulatory_reason" type="VARCHAR(120)"/>
        </addColumn>
        <sql>ALTER TABLE corretora ADD CONSTRAINT ck_corretora_regulatory_status CHECK (regulatory_status IN ('NOT_CHECKED','VERIFIED','NOT_FOUND','STALE','UNAVAILABLE'))</sql>
        <rollback>
            <sql>ALTER TABLE corretora DROP CONSTRAINT ck_corretora_regulatory_status</sql>
            <dropColumn tableName="corretora" columnName="regulatory_reason"/>
            <dropColumn tableName="corretora" columnName="regulatory_checked_at"/>
            <dropColumn tableName="corretora" columnName="regulatory_reference_at"/>
            <dropColumn tableName="corretora" columnName="regulatory_evidence_id"/>
            <dropColumn tableName="corretora" columnName="regulatory_source"/>
            <dropColumn tableName="corretora" columnName="regulatory_category"/>
            <dropColumn tableName="corretora" columnName="regulatory_status"/>
        </rollback>
    </changeSet>

    <changeSet id="009-add-read-query-indexes" author="atlas-carteira">
        <createIndex tableName="transacao" indexName="idx_transacao_tipo_data_id">
            <column name="tipo"/><column name="data_hora" descending="true"/><column name="id" descending="true"/>
        </createIndex>
        <createIndex tableName="transacao" indexName="idx_transacao_acao_data_id">
            <column name="acao_id"/><column name="data_hora" descending="true"/><column name="id" descending="true"/>
        </createIndex>
        <createIndex tableName="posicao_carteira" indexName="idx_posicao_corretora_acao_id">
            <column name="corretora_id"/><column name="acao_id"/><column name="id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="posicao_carteira" indexName="idx_posicao_corretora_acao_id"/>
            <dropIndex tableName="transacao" indexName="idx_transacao_acao_data_id"/>
            <dropIndex tableName="transacao" indexName="idx_transacao_tipo_data_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
